<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dixiesystems.menu_unidad2.NotacionController">

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
            </padding>
            <children>

                <Label text="Expresión (ej. a=b*(c+d))"/>
                <TextField fx:id="tfExpresion" promptText="Escribe la expresión..."/>

                <HBox spacing="10">
                    <children>
                        <Button text="Procesar" onAction="#onProcesar" />
                        <Button text="Limpiar"  onAction="#onLimpiar"  />
                    </children>
                </HBox>

                <Separator/>

                <GridPane hgap="10" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="75"/>
                    </columnConstraints>
                    <children>
                        <Label text="Postfija:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="tfPostfija" editable="false" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Prefija:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="tfPrefija" editable="false" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    </children>
                </GridPane>

                <Label text="Código intermedio:"/>
                <TextArea fx:id="taCodigo" prefRowCount="10" wrapText="true" editable="false"/>

            </children>
        </VBox>
    </center>

</BorderPane>
