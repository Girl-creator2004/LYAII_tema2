<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.dixiesystems.menu_unidad2.AsignacionController"
            prefWidth="600" prefHeight="400">

    <children>
        <VBox spacing="10" alignment="CENTER" layoutX="50" layoutY="30" prefWidth="500">

            <Label text=" Instrucción de Asignación" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <HBox spacing="10" alignment="CENTER">
                <Label text="Variable:"/>
                <TextField fx:id="variableName" promptText="Ej: x"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER">
                <Label text="Expresión 1:"/>
                <TextField fx:id="expression1" promptText="Ej: Hola"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER">
                <Label text="Expresión 2:"/>
                <TextField fx:id="expression2" promptText="Ej: Mundo"/>
            </HBox>

            <Button fx:id="assignButton" text="Asignar" onAction="#onAssignClick"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>

            <Label fx:id="outputLabel" text="Esperando asignación..." style="-fx-font-size: 14px;"/>

            <Label text="Historial de asignaciones:" style="-fx-font-weight: bold;"/>
            <ListView fx:id="historyList" prefHeight="150"/>
        </VBox>
    </children>
</AnchorPane>
