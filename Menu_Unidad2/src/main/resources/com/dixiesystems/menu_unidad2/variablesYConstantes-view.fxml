<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="10" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dixiesystems.menu_unidad2.VariablesyConstantesController">

    <!-- Padding corregido -->
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label text="Ingrese una expresión (ej: x = 5 + y)">
        <font>
            <Font name="Arial Black" size="14.0" />
        </font></Label>
    <TextField fx:id="expressionInput" prefWidth="300" />
    <Button onAction="#handleAnalyze" style="-fx-background-color: #FFC1CC;" text="Analizar Expresión">
        <font>
            <Font name="System Bold Italic" size="12.0" />
        </font></Button>

    <TableView fx:id="tableView" prefHeight="200" prefWidth="400">
        <columns>
            <TableColumn fx:id="symbolColumn" prefWidth="100" text="Símbolo" />
            <TableColumn fx:id="typeColumn" prefWidth="100" text="Tipo" />
            <TableColumn fx:id="valueColumn" prefWidth="100" text="Valor" />
        </columns>
    </TableView>

    <Label text="Código Intermedio:">
        <font>
            <Font name="Arial Black" size="14.0" />
        </font></Label>
    <TextArea fx:id="codeArea" prefColumnCount="40" prefRowCount="5" />

</VBox>
