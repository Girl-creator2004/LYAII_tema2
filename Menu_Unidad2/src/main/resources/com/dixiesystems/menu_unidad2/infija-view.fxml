<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.dixiesystems.menu_unidad2.InfijaController"
      spacing="15" alignment="CENTER" style="-fx-padding: 20;">

    <Label text="Ingrese expresión en notación infija:" />
    <TextField fx:id="inputExpr" promptText="Ejemplo: a+b*c" />
    <Button text="Generar Código Intermedio" onAction="#generateIntermediate" />

    <Label text="Código Intermedio (temporales):" />
    <TextArea fx:id="outputIntermediate" prefRowCount="6" wrapText="true" />

    <Label text="Ejemplo de Bytecode Java (simulado):" />
    <TextArea fx:id="outputBytecode" prefRowCount="8" wrapText="true" />

</VBox>